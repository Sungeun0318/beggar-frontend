# 기본: 자동 텍스트 판별 + LF로 정규화
* text=auto eol=lf

# Dart / Flutter 소스
*.dart        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf

# Android
*.gradle      text eol=lf
*.gradle.kts  text eol=lf
*.kt          text eol=lf
*.java        text eol=lf
*.xml         text eol=lf
*.properties  text eol=lf
*.pro         text eol=lf
gradlew       text eol=lf
gradlew.bat   text eol=crlf

# iOS / macOS
*.swift       text eol=lf
*.m           text eol=lf
*.h           text eol=lf
*.mm          text eol=lf
*.plist       text eol=lf
*.entitlements text eol=lf
*.pbxproj     text eol=lf
*.xcconfig    text eol=lf
Podfile       text eol=lf
*.podspec     text eol=lf

# Web
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.ts          text eol=lf
*.json        text eol=lf

# Windows / Linux 데스크톱
*.cmake       text eol=lf
*.rc          text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# 문서
*.md          text eol=lf
*.sql         text eol=lf
*.sh          text eol=lf

